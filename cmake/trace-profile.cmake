# Opt-in profile overlay. The verified native source directories never change.
function(tsbench_add_profile_overlay target kind suffix)
  get_target_property(dir ${target} SOURCE_DIR)
  get_target_property(original_sources ${target} SOURCES)
  set(out "${CMAKE_CURRENT_BINARY_DIR}/trace-overlay/${suffix}")
  set(matches 0)
  set(replacement)
  foreach(source IN LISTS original_sources)
    if(source MATCHES "(^|/)${suffix}$")
      get_filename_component(original "${source}" ABSOLUTE BASE_DIR "${dir}")
      get_filename_component(original_dir "${original}" DIRECTORY)
      set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${original}" "${PROJECT_SOURCE_DIR}/tools/prepare_trace_overlay.py")
      execute_process(COMMAND "${Python3_EXECUTABLE}" -I -B "${PROJECT_SOURCE_DIR}/tools/prepare_trace_overlay.py"
        "${kind}" "${original}" "${out}" COMMAND_ERROR_IS_FATAL ANY)
      list(APPEND replacement "${out}")
      math(EXPR matches "${matches}+1")
      target_include_directories(${target} PRIVATE "${original_dir}" "${PROJECT_SOURCE_DIR}/include")
    else()
      list(APPEND replacement "${source}")
    endif()
  endforeach()
  if(NOT matches EQUAL 1)
    message(FATAL_ERROR "Expected one frozen trace overlay target for ${target}/${suffix}")
  endif()
  set_property(TARGET ${target} PROPERTY SOURCES ${replacement})
  target_link_libraries(${target} PRIVATE tsbench_trace)
endfunction()

if(TARGET alp_native AND TARGET lzbench_native)
  add_executable(tsbench_profile_driver EXCLUDE_FROM_ALL native/measurement/profile_driver.cpp)
  target_link_libraries(tsbench_profile_driver PRIVATE alp_native lzbench_native)
  target_include_directories(tsbench_profile_driver PRIVATE include native/tracing)
  target_compile_features(tsbench_profile_driver PRIVATE cxx_std_17)
  if(TSBENCH_PROFILE_BUILD)
    add_library(tsbench_trace SHARED native/tracing/collector.cpp)
    target_link_libraries(tsbench_trace PRIVATE tsbench_plugin_abi)
    tsbench_add_profile_overlay(alp_native alp codec.cpp)
    tsbench_add_profile_overlay(ln_kernels zstd zstdmt_compress.c)
    target_link_libraries(tsbench_profile_driver PRIVATE tsbench_trace)
    target_compile_definitions(tsbench_profile_driver PRIVATE TSBENCH_PROFILE_BUILD=1)
  endif()
elseif(TSBENCH_PROFILE_BUILD)
  message(FATAL_ERROR "TSBENCH_PROFILE_BUILD requires alp-auto and zstd")
endif()
