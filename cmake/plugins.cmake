# The catalog owns codec package selection; CMake owns target construction.
set(TSBENCH_PLUGINS "@enabled" CACHE STRING
  "Semicolon-separated plugin IDs, @enabled for all enabled routes, empty for worker only")

function(tsbench_add_registered_plugins)
  set(root "${PROJECT_SOURCE_DIR}")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${root}/tools/resolve_cmake_plugins.py" "${root}/src/tsbench/plugins.py"
    "${root}/src/tsbench/contracts.py" "${root}/src/tsbench/assets.py")
  execute_process(COMMAND "${Python3_EXECUTABLE}" -I -B
    "${root}/tools/resolve_cmake_plugins.py" "--selection=${TSBENCH_PLUGINS}"
    OUTPUT_VARIABLE plan OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
  string(JSON watches LENGTH "${plan}" watch)
  math(EXPR last_watch "${watches} - 1")
  foreach(index RANGE 0 ${last_watch})
    string(JSON path GET "${plan}" watch ${index})
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${root}/${path}")
  endforeach()
  string(JSON packages LENGTH "${plan}" packages)
  if(packages EQUAL 0)
    return()
  endif()
  math(EXPR last_package "${packages} - 1")
  set(selected_targets)
  foreach(index RANGE 0 ${last_package})
    string(JSON package GET "${plan}" packages ${index})
    string(JSON directory GET "${package}" directory)
    string(JSON plugins LENGTH "${package}" plugins)
    math(EXPR last_plugin "${plugins} - 1")
    set(BMK_SELECTED_PLUGIN_IDS)
    set(package_targets)
    foreach(entry RANGE 0 ${last_plugin})
      string(JSON id GET "${package}" plugins ${entry} id)
      string(JSON target GET "${package}" plugins ${entry} target)
      if(TARGET "${target}")
        message(FATAL_ERROR "Codec target already exists before adding package: ${target}")
      endif()
      list(APPEND BMK_SELECTED_PLUGIN_IDS "${id}")
      list(APPEND package_targets "${target}")
    endforeach()
    add_subdirectory("${directory}" EXCLUDE_FROM_ALL)
    foreach(target IN LISTS package_targets)
      if(NOT TARGET "${target}")
        message(FATAL_ERROR "Declared codec target missing from ${directory}: ${target}")
      endif()
      get_target_property(kind "${target}" TYPE)
      get_target_property(owner "${target}" SOURCE_DIR)
      get_target_property(imported "${target}" IMPORTED)
      if(imported OR NOT owner STREQUAL "${root}/${directory}" OR
         NOT kind MATCHES "^(SHARED|MODULE)_LIBRARY$")
        message(FATAL_ERROR "Codec target must build a local shared library in ${directory}: ${target}")
      endif()
      list(APPEND selected_targets "${target}")
    endforeach()
  endforeach()
  add_custom_target(tsbench_registered_codecs ALL)
  add_dependencies(tsbench_registered_codecs ${selected_targets})
endfunction()
