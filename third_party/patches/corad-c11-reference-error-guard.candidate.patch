+/* Use the decoder's coefficient order and the existing unfused arithmetic. */
+static void cr_expand_sparse(const double *co, const double *dictionary,
+                             int atoms, int width, double *restored) {
+  for (int t = 0; t < width; t++) restored[t] = 0;
+  for (int j = 0; j < atoms; j++)
+    if (co[j] != 0)
+      for (int t = 0; t < width; t++)
+        restored[t] += co[j] * dictionary[(size_t)j * width + t];
+}
+
+/* A correlation alone is invariant to shifts and scaling. Accept a reference
+ * only if the actual decoder output pointwise dominates its own sparse record.
+ * For different results, reject rounded ties conservatively. */
+static int cr_reference_dominates(const double *original, const double *direct,
+                                  const double *ref, int width, double mean,
+                                  double scale) {
+  for (int t = 0; t < width; t++) {
+    double own = direct[t] * scale + mean;
+    double copy = ref[t] * scale + mean;
+    if (!isfinite(own) || !isfinite(copy)) return 0;
+    if (copy != own) {
+      double own_error = fabs(own - original[t]);
+      double copy_error = fabs(copy - original[t]);
+      if (!isfinite(own_error) || !(copy_error < own_error)) return 0;
+    }
+  }
+  return 1;
+}
