              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "LOSSLESS"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "threshold"
              ],
              "properties": {
                "kind": {
                  "const": "ABS"
                },
                "threshold": {
                  "type": "string",
                  "pattern": "^\\+?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
                }
              }
            }
          ]
        },
        "stages": {
          "const": [
            "TIME_AXIS_TO_FIRST",
            "LEXICOGRAPHIC_COLUMNS",
            "INDEPENDENT_BLOCKS",
            "TAIL_ENCODE"
          ]
        }
