{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "topology",
    "channels"
  ],
  "properties": {
    "schema_version": {
      "const": "tscb.channel-collection-schema.v1"
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "alignment",
        "time_pairing"
      ],
      "properties": {
        "kind": {
          "enum": [
            "ASYNCHRONOUS_MTS",
            "RAGGED_CHANNELS"
          ]
        },
        "alignment": {
          "const": "NONE"
        },
        "time_pairing": {
          "const": "PER_CHANNEL"
        }
      }
    },
    "channels": {
      "type": "array",
      "minItems": 2,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "channel_id",
          "timestamp_origin",
          "logical_schema"
        ],
        "properties": {
          "channel_id": {
            "type": "string",
            "minLength": 1
          },
          "timestamp_origin": {
            "enum": [
              "SOURCE_COLUMN",
              "MANIFEST_CONSTRUCTED",
              "NONE"
            ]
          },
          "logical_schema": {
            "$ref": "logical-object-schema.schema.json"
          }
        }
      }
    }
  },
  "title": "Ordered asynchronous/ragged per-channel logical schemas",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tscb.channel-collection-schema.v1"
}
