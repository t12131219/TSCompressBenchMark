{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "collection_schema",
    "logical_content_id",
    "underlying_bytes_sha256",
    "canonical_raw_bits",
    "payload_sha256",
    "recipe",
    "recipe_id",
    "channels"
  ],
  "properties": {
    "schema_version": {
      "const": "tscb.channel-collection-artifact.v1"
    },
    "collection_schema": {
      "$ref": "channel-collection-schema.schema.json"
    },
    "logical_content_id": {
      "type": "string",
      "minLength": 1
    },
    "underlying_bytes_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "canonical_raw_bits": {
      "type": "integer",
      "minimum": 0
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "recipe": {
      "$ref": "channel-collection-recipe.schema.json"
    },
    "recipe_id": {
      "type": "string",
      "minLength": 1
    },
    "channels": {
      "type": "array",
      "minItems": 2,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "channel_id",
          "offset",
          "length",
          "sha256",
          "ledger",
          "recipe_id",
          "logical_content_id"
        ],
        "properties": {
          "channel_id": {
            "type": "string",
            "minLength": 1
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "length": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "ledger": {
            "$ref": "pipeline-ledger.schema.json"
          },
          "recipe_id": {
            "type": "string",
            "minLength": 1
          },
          "logical_content_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "title": "Fully charged independent P2 channel frame envelope",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tscb.channel-collection-artifact.v1"
}
