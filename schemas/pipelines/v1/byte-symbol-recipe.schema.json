{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tscb.byte-symbol-recipe.v1",
  "title": "Explicit BYTE_TO_RADIX4 child bridge recipe",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "child", "block_size_bytes", "mapping", "digit_order", "digit_dtype", "digits_per_byte", "padding_digits", "tail_policy", "stages"],
  "properties": {
    "schema_version": {"const": "tscb.byte-symbol-recipe.v1"},
    "child": {"type": "object", "additionalProperties": false, "required": ["codec_key", "parameters"], "properties": {"codec_key": {"const": "deepzip"}, "parameters": {"type": "object"}}},
    "block_size_bytes": {"type": "integer", "minimum": 1, "maximum": 4194304},
    "mapping": {"const": "BYTE_TO_RADIX4"},
    "digit_order": {"const": "MSB_FIRST_6_4_2_0"},
    "digit_dtype": {"const": "|u1"},
    "digits_per_byte": {"const": 4},
    "padding_digits": {"const": 0},
    "tail_policy": {"const": "COMPRESS_TRUE_DIGIT_COUNT"},
    "stages": {"const": ["BYTE_TO_RADIX4_MSB_FIRST", "EXISTING_CHILD_BLOCKS", "RADIX4_TO_BYTE_MSB_FIRST"]}
  }
}
