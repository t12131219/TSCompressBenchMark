{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "collection_schema",
    "logical_content_id",
    "underlying_bytes_sha256",
    "canonical_raw_bits",
    "payload_sha256",
    "validity_present",
    "buffers"
  ],
  "properties": {
    "schema_version": {
      "const": "tscb.channel-collection-raw.v1"
    },
    "collection_schema": {
      "$ref": "channel-collection-schema.schema.json"
    },
    "logical_content_id": {
      "type": "string",
      "minLength": 1
    },
    "underlying_bytes_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "canonical_raw_bits": {
      "type": "integer",
      "minimum": 0
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "validity_present": {
      "type": "array",
      "minItems": 2,
      "maxItems": 1024,
      "items": {
        "type": "boolean"
      }
    },
    "buffers": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "channel_id",
          "role",
          "owner",
          "offset",
          "length",
          "sha256"
        ],
        "properties": {
          "channel_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "VALUE",
              "TIMESTAMP",
              "VALIDITY"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "length": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  },
  "title": "Bounded hash-checked original per-channel buffers",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tscb.channel-collection-raw.v1"
}
