{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "channels"
  ],
  "properties": {
    "schema_version": {
      "const": "tscb.channel-collection-recipe.v1"
    },
    "channels": {
      "type": "array",
      "minItems": 2,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "channel_id",
          "recipe"
        ],
        "properties": {
          "channel_id": {
            "type": "string",
            "minLength": 1
          },
          "recipe": {
            "$ref": "pipeline-recipe.schema.json"
          }
        }
      }
    }
  },
  "title": "Lossless existing-P2 recipe for every original channel",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tscb.channel-collection-recipe.v1"
}
