{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "value_children",
    "timestamp_child",
    "mask_child",
    "block_size",
    "tail_policy",
    "loss_contract",
    "stages"
  ],
  "properties": {
    "schema_version": {
      "const": "tscb.pipeline-recipe.v1"
    },
    "value_children": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "codec_key",
          "parameters"
        ],
        "properties": {
          "codec_key": {
            "type": "string",
            "minLength": 1
          },
          "parameters": {
            "type": "object"
          }
        }
      }
    },
    "timestamp_child": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "codec_key",
            "parameters"
          ],
          "properties": {
            "codec_key": {
              "type": "string",
              "minLength": 1
            },
            "parameters": {
              "type": "object"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "mask_child": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "codec_key",
            "parameters"
          ],
          "properties": {
            "codec_key": {
              "type": "string",
              "minLength": 1
            },
            "parameters": {
              "type": "object"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "block_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16777216
    },
    "tail_policy": {
      "enum": [
        "RAW_TAIL",
        "COMPRESS_TAIL"
      ]
    },
    "loss_contract": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "LOSSLESS"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "threshold"
          ],
          "properties": {
            "kind": {
              "const": "ABS"
            },
            "threshold": {
              "type": "string",
              "pattern": "^\\+?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
            }
          }
        }
      ]
    },
    "stages": {
      "const": [
        "TIME_AXIS_TO_FIRST",
        "LEXICOGRAPHIC_COLUMNS",
        "INDEPENDENT_BLOCKS",
        "TAIL_ENCODE"
      ]
    }
  },
  "title": "Frozen reversible P2 column/block recipe using existing children",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tscb.pipeline-recipe.v1"
}
