{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frozen workload comparison contract (not a qualification result)",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "purpose", "track", "original", "representation", "task", "control", "quality", "access", "resource", "boundary", "validation", "retention"],
  "properties": {
    "schema": {"const": "bmk.comparison-contract/1"},
    "purpose": {"enum": ["development_diagnostic", "primary_timing"]},
    "track": {"enum": ["original_task", "representation_controlled"]},
    "task": {"enum": ["values_only", "timestamps_only", "shared_t_controlled", "whole_object"]},
    "original": {"type": "object", "additionalProperties": false,
      "required": ["object_id", "schema_id", "logical_bytes"],
      "properties": {"object_id": {"$ref": "#/$defs/id"}, "schema_id": {"$ref": "#/$defs/id"}, "logical_bytes": {"$ref": "#/$defs/count"}}},
    "representation": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false,
      "required": ["input_id", "schema_id", "layout_id"], "properties": {
        "input_id": {"$ref": "#/$defs/id"}, "schema_id": {"$ref": "#/$defs/id"}, "layout_id": {"$ref": "#/$defs/id"}}}]},
    "control": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false,
      "required": ["kind", "route_id"], "properties": {"kind": {"enum": ["fixed_timestamp_route", "fixed_value_route"]}, "route_id": {"$ref": "#/$defs/id"}}}]},
    "quality": {"type": "object", "additionalProperties": false, "required": ["kind", "exact_components", "max_abs_by_column", "exception_policy"],
      "properties": {"kind": {"enum": ["bitwise_exact", "original_domain_max_abs"]},
        "exact_components": {"type": "array", "uniqueItems": true, "items": {"enum": ["T", "V", "mask", "status"]}},
        "max_abs_by_column": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}},
        "exception_policy": {"enum": ["preserve_bits", "reject_outside_domain"]}}},
    "access": {"type": "object", "additionalProperties": false,
      "required": ["mode", "mechanism", "ingress_id", "partition_id", "workload_id", "stream"],
      "properties": {"mode": {"enum": ["batch_whole", "stream_chunked", "stream_strict_online"]},
        "mechanism": {"enum": ["any_qualified", "native_only"]},
        "ingress_id": {"$ref": "#/$defs/id"}, "partition_id": {"$ref": "#/$defs/id"}, "workload_id": {"$ref": "#/$defs/id"},
        "stream": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/stream"}]}}},
    "resource": {"type": "object", "additionalProperties": false,
      "required": ["hardware_group_id", "physical_cores", "participant_threads", "peak_resident_bytes", "max_serialized_bytes", "deadline_ns"],
      "properties": {"hardware_group_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "physical_cores": {"oneOf": [{"$ref": "#/$defs/limit"}, {"type": "null"}]},
        "participant_threads": {"$ref": "#/$defs/limit"},
        "peak_resident_bytes": {"oneOf": [{"$ref": "#/$defs/limit"}, {"type": "null"}]},
        "max_serialized_bytes": {"$ref": "#/$defs/limit"}, "deadline_ns": {"$ref": "#/$defs/limit"}}},
    "boundary": {"type": "object", "additionalProperties": false,
      "required": ["direction", "extent", "lifecycle", "state", "state_protocol_id", "cache_policy_id", "ownership", "completion", "output_boundary_id", "size_scope", "size_accounting_id", "measurement_protocol_id"],
      "properties": {"direction": {"enum": ["encode", "decode", "roundtrip"]},
        "extent": {"enum": ["payload", "frame", "pipeline_service", "pipeline_full"]},
        "lifecycle": {"enum": ["steady", "cold", "process"]}, "state": {"enum": ["reset_per_message", "carry_stream", "frozen_model"]},
        "state_protocol_id": {"$ref": "#/$defs/id"}, "cache_policy_id": {"$ref": "#/$defs/id"},
        "ownership": {"enum": ["caller_owned", "plugin_owned", "copied_return"]},
        "completion": {"enum": ["result_ready", "request_consumed", "stream_finished"]}, "output_boundary_id": {"$ref": "#/$defs/id"},
        "size_scope": {"enum": ["payload", "representation", "full_frame", "bundle"]}, "size_accounting_id": {"$ref": "#/$defs/id"}, "measurement_protocol_id": {"$ref": "#/$defs/id"}}},
    "validation": {"type": "object", "additionalProperties": false, "required": ["strength", "placement", "protocol_id"],
      "properties": {"strength": {"enum": ["artifact_each", "artifact_replay", "sample_only"]}, "placement": {"enum": ["inside_extent", "outside_extent"]}, "protocol_id": {"$ref": "#/$defs/id"}}},
    "retention": {"type": "object", "additionalProperties": false,
      "required": ["samples_per_case_method", "independent_restore", "retain_failures", "dependency_policy_id"],
      "properties": {"samples_per_case_method": {"$ref": "#/$defs/limit"}, "independent_restore": {"const": true},
        "retain_failures": {"const": true}, "dependency_policy_id": {"$ref": "#/$defs/id"}}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
    "count": {"type": "integer", "minimum": 0},
    "limit": {"type": "integer", "minimum": 1},
    "stream": {"type": "object", "additionalProperties": false,
      "required": ["max_buffer_bytes", "max_first_output_ns", "max_output_gap_ns", "backpressure", "finish_restores_all", "replay_allowed"],
      "properties": {"max_buffer_bytes": {"$ref": "#/$defs/limit"}, "max_first_output_ns": {"$ref": "#/$defs/limit"},
        "max_output_gap_ns": {"$ref": "#/$defs/limit"}, "backpressure": {"const": true},
        "finish_restores_all": {"const": true}, "replay_allowed": {"type": "boolean"}}}
  }
}
