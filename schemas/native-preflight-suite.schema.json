{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","id","stage","state","scope_suite","policies","groups","tests"],
  "properties":{
    "schema":{"const":"bmk.native-preflight-suite/1"},
    "id":{"const":"m0_native_candidate_v1"},
    "stage":{"const":"M0"},
    "state":{"const":"development_preflight"},
    "scope_suite":{"enum":["first_batch_service_v2","first_batch_service_v3"]},
    "policies":{"const":{
      "submission":"one_complete_plan_one_run",
      "platform":"linux_x86_64",
      "max_workers":1,
      "timing":"development_diagnostics_only",
      "retention":"retain_validator_outputs_and_logs",
      "interruption":"unsealed_is_incomplete"
    }},
    "groups":{"type":"array","minItems":1,"maxItems":100,"items":{
      "type":"object","additionalProperties":false,"required":["selection","routes","test"],
      "properties":{
        "selection":{"type":"integer","minimum":1},
        "routes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
        "test":{"$ref":"#/$defs/id"}
      }
    }},
    "tests":{"type":"array","minItems":1,"maxItems":100,"items":{
      "type":"object","additionalProperties":false,"required":["name"],
      "properties":{
        "name":{"$ref":"#/$defs/id"},
        "output_arg":{"$ref":"#/$defs/id"},
        "evidence":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
        "binary_evidence":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
        "smoke_export":{"const":true}
      }
    }}
  },
  "$defs":{"id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]*(?![\\s\\S])"}}
}
