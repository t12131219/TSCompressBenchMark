{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bmk.m2-real-corpus-stage-receipt/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "stage", "stage_accepted", "qualification_granted", "timing_admitted", "scope", "evidence", "coverage", "open_items", "receipt_id"],
  "properties": {
    "schema": {"const": "bmk.m2-real-corpus-stage-receipt/1"},
    "stage": {"const": "M2"},
    "stage_accepted": {"const": true},
    "qualification_granted": {"const": false},
    "timing_admitted": {"const": false},
    "scope": {"const": "updated_real_corpus_measurement_and_scheduler_protocol"},
    "evidence": {"type": "object", "minProperties": 7},
    "coverage": {"type": "object", "required": ["real_corpus_datasets_bound", "native_routes_bound", "m1_inputs_bound", "timing_batches_per_repeat", "repeats", "directions", "cache_cases", "verified_batches"]},
    "open_items": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "receipt_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
