{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,
  "required":["schema","environment","protocols","routes"],
  "properties":{
    "schema":{"const":"bmk.native-admission-policy/1"},
    "environment":{"type":"object","additionalProperties":false,
      "required":["os","arch","device","libc","python_environment_lock","build_profile","c_cxx_compiler","cmake","isolation"],
      "properties":{"os":{"const":"linux"},"arch":{"const":"x86_64"},"device":{"const":"cpu"},"libc":{"const":"glibc"},
        "python_environment_lock":{"const":"environment/tsbench-linux-64.lock.json"},"build_profile":{"const":"Release"},
        "c_cxx_compiler":{"$ref":"#/$defs/text"},"cmake":{"$ref":"#/$defs/text"},"isolation":{"const":"files_only_bubblewrap_compatible_cpu"}}},
    "protocols":{"type":"object","minProperties":1,"additionalProperties":{"type":"object","additionalProperties":false,
      "required":["completion","retain"],"properties":{"completion":{"$ref":"#/$defs/text"},
      "retain":{"type":"array","minItems":2,"uniqueItems":true,"items":{"$ref":"#/$defs/text"}}}}},
    "routes":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,
      "required":["selection","route","domain"],"properties":{"selection":{"type":"integer","minimum":1},
      "route":{"type":"string","pattern":"^[a-z0-9-]+$"},"domain":{"$ref":"#/$defs/text"}}}}
  },
  "$defs":{"text":{"type":"string","minLength":1,"maxLength":512}}
}
