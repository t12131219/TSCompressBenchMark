{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M1 lossless runner suite",
  "type": "object",
  "allOf": [
    {"if": {"properties": {"id": {"const": "m1_lossless_formal_v1"}}},
     "then": {"properties": {"admission": {"const": "m0_receipt_bound"}, "purpose": {"const": "m1_formal_execution"}},
               "required": ["m0_receipt"]},
     "else": {"properties": {"admission": {"const": "preflight_only_m0_not_accepted"}, "purpose": {"const": "m1_candidate_preflight"}}}}
  ],
  "additionalProperties": false,
  "if": {"properties": {"id": {"const": "m1_lossless_candidate_v1"}}},
  "then": {"properties": {"schema": {"const": "bmk.lossless-stage-suite/1"},
                          "measurement": {"properties": {"mode": {"const": "not_collected"}}}}},
  "else": {"properties": {"measurement": {"properties": {"mode": {"const": "process_frame_preflight"}}}},
    "if": {"properties": {"id": {"enum": ["m1_lossless_candidate_v3", "m1_lossless_formal_v1"]}}},
    "then": {"properties": {"schema": {"const": "bmk.lossless-stage-suite/3"}}},
    "else": {"properties": {"schema": {"const": "bmk.lossless-stage-suite/2"}}}},
  "properties": {
    "schema": {
      "enum": ["bmk.lossless-stage-suite/1", "bmk.lossless-stage-suite/2", "bmk.lossless-stage-suite/3"]
    },
    "id": {
      "enum": ["m1_lossless_candidate_v1", "m1_lossless_candidate_v2", "m1_lossless_candidate_v3", "m1_lossless_formal_v1"]
    },
    "stage": {
      "const": "M1"
    },
    "admission": {
      "enum": ["preflight_only_m0_not_accepted", "m0_receipt_bound"]
    },
    "purpose": {
      "enum": ["m1_candidate_preflight", "m1_formal_execution"]
    },
    "m0_receipt": {"type": "string", "minLength": 1},
    "task": {
      "const": "values_only"
    },
    "comparison_track": {
      "const": "O"
    },
    "quality": {
      "const": "original_f64_bitwise_exact"
    },
    "access": {
      "const": "whole_value_column_batch"
    },
    "verification": {
      "const": "artifact_each"
    },
    "verification_placement": {
      "const": "outside_measurement"
    },
    "timeout_seconds_per_operation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    },
    "max_serialized_bytes_per_slot": {
      "type": "integer",
      "minimum": 65536,
      "maximum": 262144
    },
    "scheduling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "competing_methods": {
          "const": "serial"
        },
        "requested_threads": {
          "type": "integer",
          "const": 1
        },
        "state_reset": {
          "const": "new_worker_each_operation"
        },
        "max_attempts": {
          "type": "integer",
          "const": 1
        }
      },
      "required": [
        "competing_methods",
        "requested_threads",
        "state_reset",
        "max_attempts"
      ]
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": ["not_collected", "process_frame_preflight"]
        },
        "byte_boundary": {
          "const": "complete_worker_frame_including_schema"
        }
      },
      "required": [
        "mode",
        "byte_boundary"
      ]
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verified_samples_per_slot": {
          "type": "integer",
          "const": 1
        },
        "preserve_raw_ledger_and_failures": {
          "const": true
        }
      },
      "required": [
        "verified_samples_per_slot",
        "preserve_raw_ledger_and_failures"
      ]
    },
    "fixture_manifest": {
      "const": "datasets/fixtures/manifest.json"
    },
    "corpus_manifest": {
      "const": "datasets/manifests/first-batch-real-v1.json"
    },
    "direct_control": {
      "const": "configs/experiments/measurement_controls/direct_routes_v1.json"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*(?![\\s\\S])"
          },
          "input": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "empty_f64"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "fixture"
                  },
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z0-9-]+\\.npy(?![\\s\\S])"
                  }
                },
                "required": [
                  "kind",
                  "name"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "corpus_window"
                  },
                  "dataset": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]*(?![\\s\\S])"
                  },
                  "partition": {
                    "const": "test"
                  },
                  "column": {
                    "type": "string",
                    "pattern": "^[A-Za-z][a-zA-Z0-9_]*(?![\\s\\S])"
                  },
                  "offset": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 150000
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 8192
                  }
                },
                "required": [
                  "kind",
                  "dataset",
                  "partition",
                  "column",
                  "offset",
                  "count"
                ]
              }
            ]
          }
        },
        "required": [
          "id",
          "input"
        ]
      },
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true
    },
    "methods": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "plugin": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*(?![\\s\\S])"
          },
          "role": {
            "enum": [
              "bytes",
              "value"
            ]
          },
          "options": {
            "type": "object"
          }
        },
        "required": [
          "plugin",
          "role",
          "options"
        ]
      },
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cases": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "methods": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "slots": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      },
      "required": [
        "cases",
        "methods",
        "slots"
      ]
    }
  },
  "required": [
    "schema",
    "id",
    "stage",
    "admission",
    "purpose",
    "task",
    "comparison_track",
    "quality",
    "access",
    "verification",
    "verification_placement",
    "timeout_seconds_per_operation",
    "max_serialized_bytes_per_slot",
    "scheduling",
    "measurement",
    "retention",
    "fixture_manifest",
    "corpus_manifest",
    "direct_control",
    "cases",
    "methods",
    "expected"
  ]
}
