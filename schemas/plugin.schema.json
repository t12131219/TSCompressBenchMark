{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BMK plugin manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "kind",
    "abi_version",
    "implementation_version",
    "format_id",
    "roles",
    "options_schema",
    "source_files"
  ],
  "properties": {
    "schema": {
      "const": "bmk.plugin/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*(?![\\s\\S])"
    },
    "kind": {
      "const": "codec"
    },
    "abi_version": {
      "type": "integer",
      "const": 1
    },
    "implementation_version": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*(?![\\s\\S])"
    },
    "format_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*(?![\\s\\S])"
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "value",
          "timestamp",
          "timestamp_value",
          "bytes"
        ]
      }
    },
    "options_schema": {
      "type": "string",
      "minLength": 1
    },
    "value_representation": {"const": "dense-u16-interleaved"},
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cmake_dir", "target"],
      "properties": {
        "cmake_dir": {"type": "string", "pattern": "^plugins/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+(?![\\s\\S])"},
        "target": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*(?![\\s\\S])"}
      }
    },
    "supported_tasks": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["linear_f64_bitwise"]}
    },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "runtime_dependencies": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^lib[A-Za-z0-9_.-]+\\.so(?:\\.[0-9]+)*(?![\\s\\S])"
      }
    }
  }
}
