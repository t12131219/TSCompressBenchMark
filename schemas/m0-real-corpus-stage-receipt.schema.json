{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bmk.m0-real-corpus-stage-receipt/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "stage", "stage_accepted", "qualification_granted", "timing_admitted", "scope", "evidence", "coverage", "open_items", "receipt_id"],
  "properties": {
    "schema": {"const": "bmk.m0-real-corpus-stage-receipt/1"},
    "stage": {"const": "M0"},
    "stage_accepted": {"const": true},
    "qualification_granted": {"const": false},
    "timing_admitted": {"const": false},
    "scope": {"const": "freeze_contracts_and_real_corpus_binding"},
    "evidence": {"type": "object", "minProperties": 1},
    "coverage": {"type": "object", "required": ["datasets", "routes", "file_route_decisions", "required_obligations", "conditional_obligations"], "additionalProperties": true},
    "open_items": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "receipt_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
