{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tscompbench.local/schemas/v2/codec-alias.schema.json",
  "title": "Audited logical spreadsheet name mapped to a canonical codec",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "key", "canonical_key", "canonical_algorithm_id", "source_artifact_id", "mapping_kind", "evidence", "limitations"],
  "properties": {
    "schema_version": {"const": "tscb.codec-alias.v2"},
    "key": {"type": "string", "minLength": 1},
    "canonical_key": {"type": "string", "minLength": 1},
    "canonical_algorithm_id": {"type": "string", "pattern": "^v2:algorithm:sha256:[0-9a-f]{64}$"},
    "source_artifact_id": {"type": "string", "pattern": "^v2:source-artifact:sha256:[0-9a-f]{64}$"},
    "mapping_kind": {"const": "SPREADSHEET_SOURCE_MAPPING_NOT_NEW_CODEC"},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
