{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tscb.summary-record.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "summary_id", "run_set_id", "dataset_id", "algorithm_id", "config_id", "execution_path_hash", "profile_id", "run_record_schema", "track", "object_level", "loss_mode", "semantic_comparability_key", "execution_comparability_key", "resource_profile_key", "n", "repetition_indices", "run_ids", "input_sha256s", "bitstream_sha256s", "source_artifact_id", "adapter_id", "binary_artifact_sha256", "environment_id", "source_sha256", "canonical_artifact_sha256", "canonical_content_sha256", "canonical_raw_bits", "serialized_bits", "external_side_information_bits", "final_bits", "final_physical_bytes", "size_ratio", "compression_factor", "semantic_encode_mb_per_second_micro", "semantic_decode_mb_per_second_micro", "resource_observation_count"],
  "properties": {
    "schema_version": {"const": "tscb.summary-record.v2"},
    "summary_id": {"type": "string"},
    "run_set_id": {"type": "string"},
    "dataset_id": {"type": "string"},
    "algorithm_id": {"type": "string"},
    "config_id": {"type": "string"},
    "execution_path_hash": {"type": "string"},
    "profile_id": {"type": "string"},
    "run_record_schema": {"const": "tscb.run-record.v2"},
    "track": {"enum": ["TIMESTAMP", "VALUE", "SYSTEM"]},
    "object_level": {"type": "string"},
    "loss_mode": {"type": "string"},
    "semantic_comparability_key": {"type": "string"},
    "execution_comparability_key": {"type": "string"},
    "resource_profile_key": {"type": "string"},
    "n": {"type": "integer", "minimum": 1},
    "repetition_indices": {"type": "array", "items": {"type": "integer", "minimum": 0}},
    "run_ids": {"type": "array", "items": {"type": "string"}},
    "input_sha256s": {"type": "array", "items": {"type": "string"}},
    "bitstream_sha256s": {"type": "array", "items": {"type": "string"}},
    "source_artifact_id": {"type": "string"},
    "adapter_id": {"type": "string"},
    "binary_artifact_sha256": {"type": "string"},
    "environment_id": {"type": "string"},
    "source_sha256": {"type": ["string", "null"]},
    "canonical_artifact_sha256": {"type": ["string", "null"]},
    "canonical_content_sha256": {"type": ["string", "null"]},
    "canonical_raw_bits": {"type": "integer", "minimum": 0},
    "serialized_bits": {"type": "integer", "minimum": 0},
    "external_side_information_bits": {"type": "integer", "minimum": 0},
    "final_bits": {"type": "integer", "minimum": 0},
    "final_physical_bytes": {"type": "integer", "minimum": 0},
    "size_ratio": {"type": ["string", "null"]},
    "compression_factor": {"type": ["string", "null"]},
    "semantic_encode_mb_per_second_micro": {"type": ["string", "null"]},
    "semantic_decode_mb_per_second_micro": {"type": ["string", "null"]},
    "resource_observation_count": {"type": "integer", "minimum": 0}
  },
  "patternProperties": {
    "^(encode_ns|decode_ns|e2e_ns|rmse|mae|max_ae|psnr_range_db|process_cpu_seconds|peak_memory_bytes|incremental_peak_memory_bytes|cpu_core_seconds_per_gb)_(median|p25|p75|mean|sd|cv|ci_low|ci_high)$": {"type": ["number", "null"]}
  }
}
