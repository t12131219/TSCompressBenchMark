{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tscompbench.local/schemas/v2/execution-resolution.schema.json",
  "title": "Time Series Compression Benchmark V2 Execution Resolution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "reason_code", "algorithm_id", "source_artifact_id",
    "adapter_id", "backend", "artifact_sha256", "toolchain_profile_id",
    "requested_isa", "actual_isa", "runtime_dispatch", "required_alignment_bytes",
    "input_alignment_bytes", "tail_elements", "tail_path", "fallback_used", "fallback_reason",
    "cpu_affinity", "threads", "processes", "device", "runner_implementation",
    "runner_version", "environment_id", "allocation_policy", "cache_policy",
    "state_policy", "gc_policy", "jit_policy", "execution_path_hash"
  ],
  "properties": {
    "schema_version": {"const": "tscb.execution-resolution.v2"},
    "status": {"type": "string"},
    "reason_code": {"type": "string"},
    "algorithm_id": {"type": "string"},
    "source_artifact_id": {"type": "string"},
    "adapter_id": {"type": "string"},
    "backend": {"type": "string"},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "toolchain_profile_id": {"type": "string"},
    "requested_isa": {"type": "string"},
    "actual_isa": {"type": "string"},
    "runtime_dispatch": {"type": "boolean"},
    "required_alignment_bytes": {"type": "integer", "minimum": 1},
    "input_alignment_bytes": {"type": "integer", "minimum": 1},
    "tail_elements": {"type": "integer", "minimum": 0},
    "tail_path": {"type": "string"},
    "fallback_used": {"type": "boolean"},
    "fallback_reason": {"type": "string"},
    "cpu_affinity": {"type": "array", "items": {"type": "integer"}},
    "threads": {"type": "integer", "minimum": 1},
    "processes": {"type": "integer", "minimum": 1},
    "device": {"type": "string"},
    "runner_implementation": {"type": "string"},
    "runner_version": {"type": "string"},
    "environment_id": {"type": "string"},
    "allocation_policy": {"type": "string"},
    "cache_policy": {"type": "string"},
    "state_policy": {"type": "string"},
    "gc_policy": {"type": "string"},
    "jit_policy": {"type": "string"},
    "execution_path_hash": {"type": "string"}
  }
}
