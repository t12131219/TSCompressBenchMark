{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BMK required-service semantics v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "groups",
    "semantics"
  ],
  "properties": {
    "schema": {
      "const": "bmk.required-capabilities/1"
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "atoms"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*(?![\\s\\S])"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "atoms": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_]+/[a-z0-9_]+_v[1-9][0-9]*(?![\\s\\S])"
            }
          }
        }
      }
    },
    "semantics": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9_]+/[a-z0-9_]+_v[1-9][0-9]*(?![\\s\\S])"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
