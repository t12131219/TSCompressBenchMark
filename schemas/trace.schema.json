{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded host-monotonic trace snapshot from one profiling operation",
  "type": "object", "additionalProperties": false,
  "required": ["capacity_per_thread", "spans", "dropped"],
  "properties": {
    "capacity_per_thread": {"type": "integer", "minimum": 1, "maximum": 256},
    "dropped": {"type": "integer", "minimum": 0},
    "spans": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["span_id", "parent_id", "thread_id", "stage", "start_ns", "end_ns"],
      "properties": {
        "span_id": {"type": "integer", "minimum": 1, "maximum": 4096},
        "parent_id": {"type": "integer", "minimum": 0, "maximum": 4096},
        "thread_id": {"type": "integer", "minimum": 1},
        "stage": {"enum": [1, 2, 3, 4, 5, 6]},
        "start_ns": {"type": "integer", "minimum": 0},
        "end_ns": {"type": "integer", "minimum": 1}
      }
    }}
  }
}
