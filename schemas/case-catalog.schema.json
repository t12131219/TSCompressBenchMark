{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BMK draft case intent catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "state",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "bmk.case-catalog/1"
    },
    "state": {
      "const": "draft_case_intent_not_run"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "atoms",
          "development_fixtures",
          "checks"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*(?![\\s\\S])"
          },
          "atoms": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_]+/[a-z0-9_]+_v[1-9][0-9]*(?![\\s\\S])"
            }
          },
          "development_fixtures": {
            "type": "array",
            "minItems": 0,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]*(?![\\s\\S])"
            }
          },
          "checks": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
