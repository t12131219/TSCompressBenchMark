{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tscb.implementation-definition.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "method_id",
    "source_artifact_id",
    "source_closure_sha256",
    "implementation_variant"
  ],
  "properties": {
    "schema_version": {
      "const": "tscb.implementation-definition.v1"
    },
    "method_id": {
      "type": "string",
      "minLength": 1
    },
    "source_artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "source_closure_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "implementation_variant": {
      "type": "string",
      "minLength": 1
    }
  }
}
