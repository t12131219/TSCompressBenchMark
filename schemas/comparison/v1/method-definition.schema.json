{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tscb.method-definition.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "mechanism",
    "variant",
    "semantic_version",
    "definition_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "tscb.method-definition.v1"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "mechanism": {
      "type": "string",
      "minLength": 1
    },
    "variant": {
      "type": "string",
      "minLength": 1
    },
    "semantic_version": {
      "type": "string",
      "minLength": 1
    },
    "definition_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
