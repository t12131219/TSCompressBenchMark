{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tscb.execution-job.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_spec_id",
    "member_id",
    "method_id",
    "implementation_id",
    "algorithm_id",
    "config_id",
    "recipe_id",
    "view_id",
    "execution_path_hash",
    "source_artifact_id",
    "build_id",
    "runtime_id",
    "original_content_id",
    "actual_input_id",
    "actual_input_schema_id",
    "path",
    "backend",
    "actual_isa",
    "timing_boundary",
    "state",
    "resources",
    "loss_mode",
    "guarantee"
  ],
  "properties": {
    "schema_version": {
      "const": "tscb.execution-job.v1"
    },
    "task_spec_id": {
      "type": "string",
      "minLength": 1
    },
    "member_id": {
      "type": "string",
      "minLength": 1
    },
    "method_id": {
      "type": "string",
      "minLength": 1
    },
    "implementation_id": {
      "type": "string",
      "minLength": 1
    },
    "algorithm_id": {
      "type": "string",
      "minLength": 1
    },
    "config_id": {
      "type": "string",
      "minLength": 1
    },
    "recipe_id": {
      "type": "string",
      "minLength": 1
    },
    "view_id": {
      "type": "string",
      "minLength": 1
    },
    "execution_path_hash": {
      "type": "string",
      "minLength": 1
    },
    "source_artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "build_id": {
      "type": "string",
      "minLength": 1
    },
    "runtime_id": {
      "type": "string",
      "minLength": 1
    },
    "original_content_id": {
      "type": "string",
      "minLength": 1
    },
    "actual_input_id": {
      "type": "string",
      "minLength": 1
    },
    "actual_input_schema_id": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "enum": [
        "DIRECT",
        "EXACT_WIDEN",
        "LOSSY_CAST",
        "BYTE_SERIALIZATION",
        "COLUMN_INDEPENDENT",
        "JOINT",
        "SOURCE_REJECT_RAW"
      ]
    },
    "backend": {
      "type": "string",
      "minLength": 1
    },
    "actual_isa": {
      "type": "string",
      "minLength": 1
    },
    "timing_boundary": {
      "type": "string",
      "enum": [
        "PIPELINE",
        "E2E",
        "CORE_API"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "INDEPENDENT_OBJECT",
        "CONTINUOUS_STREAM"
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device",
        "threads",
        "processes",
        "memory_limit_bytes",
        "machine_policy_id",
        "isa_policy",
        "allowed_isa"
      ],
      "properties": {
        "device": {
          "const": "CPU"
        },
        "threads": {
          "type": "integer",
          "minimum": 1
        },
        "processes": {
          "type": "integer",
          "minimum": 1
        },
        "memory_limit_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "machine_policy_id": {
          "type": "string",
          "minLength": 1
        },
        "isa_policy": {
          "type": "string",
          "enum": [
            "ANY_AVAILABLE",
            "FIXED"
          ]
        },
        "allowed_isa": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      }
    },
    "loss_mode": {
      "type": "string",
      "enum": [
        "LOSSLESS",
        "ERROR_BOUNDED_LOSSY",
        "UNBOUNDED_LOSSY",
        "RATE_CONTROLLED_LOSSY"
      ]
    },
    "guarantee": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "metric",
        "threshold",
        "unit",
        "original_domain_total"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "LOSSLESS",
            "PROVEN_BOUND",
            "UNBOUNDED",
            "RATE_CONTROLLED"
          ]
        },
        "metric": {
          "type": [
            "string",
            "null"
          ]
        },
        "threshold": {
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "original_domain_total": {
          "type": "boolean"
        }
      }
    }
  }
}
