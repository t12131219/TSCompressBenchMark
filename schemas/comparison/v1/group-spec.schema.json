{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tscb.group-spec.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "revision",
    "contract_id",
    "corpus_id",
    "config_map_id",
    "expected_matrix_id",
    "scope",
    "minimum_distinct_methods",
    "minimum_independent_real_sources",
    "completion_policy",
    "members",
    "method_equivalence"
  ],
  "properties": {
    "schema_version": {
      "const": "tscb.group-spec.v1"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "contract_id": {
      "type": "string",
      "minLength": 1
    },
    "corpus_id": {
      "type": "string",
      "minLength": 1
    },
    "config_map_id": {
      "type": "string",
      "minLength": 1
    },
    "expected_matrix_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "enum": [
        "CORE_COMPARISON",
        "RESEARCH"
      ]
    },
    "minimum_distinct_methods": {
      "type": "integer",
      "minimum": 1
    },
    "minimum_independent_real_sources": {
      "type": "integer",
      "minimum": 1
    },
    "completion_policy": {
      "const": "ALL_CORE_LEGAL_CONFIGS_AND_EXPECTED_TERMINALS"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "member_id",
          "codec_key",
          "role",
          "method",
          "implementation",
          "allowed_paths",
          "shared_code_tags"
        ],
        "properties": {
          "member_id": {
            "type": "string",
            "minLength": 1
          },
          "codec_key": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "CORE",
              "EXTENSION",
              "REFERENCE"
            ]
          },
          "method": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "mechanism",
              "variant",
              "semantic_version",
              "definition_sha256"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "mechanism": {
                "type": "string",
                "minLength": 1
              },
              "variant": {
                "type": "string",
                "minLength": 1
              },
              "semantic_version": {
                "type": "string",
                "minLength": 1
              },
              "definition_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "implementation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "method_id",
              "source_artifact_id",
              "source_closure_sha256",
              "implementation_variant"
            ],
            "properties": {
              "method_id": {
                "type": "string",
                "minLength": 1
              },
              "source_artifact_id": {
                "type": "string",
                "minLength": 1
              },
              "source_closure_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "implementation_variant": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "allowed_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "DIRECT",
                "EXACT_WIDEN",
                "LOSSY_CAST",
                "BYTE_SERIALIZATION",
                "COLUMN_INDEPENDENT",
                "JOINT",
                "SOURCE_REJECT_RAW"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "shared_code_tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          }
        }
      },
      "minItems": 1,
      "uniqueItems": false
    },
    "method_equivalence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "class_id",
          "members",
          "basis",
          "evidence"
        ],
        "properties": {
          "class_id": {
            "type": "string",
            "minLength": 1
          },
          "members": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "basis": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": false
          }
        }
      },
      "minItems": 1,
      "uniqueItems": false
    }
  }
}
