{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tscb.measurement-protocol.v3.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outer_repetitions",
    "encode_min_ns",
    "decode_min_ns",
    "max_trial_wall_ns",
    "max_total_wall_ns",
    "max_inner_iterations",
    "min_outer_repetitions",
    "pilot_repetitions",
    "min_clock_signal_ratio",
    "warmup_min_count",
    "warmup_min_ns",
    "max_retries",
    "pilot_seed",
    "profile",
    "start_method",
    "worker_initial_state",
    "timing_scope",
    "cache_policy",
    "collector_mode",
    "stop_mode",
    "schema_version",
    "estimand",
    "clock",
    "context_policy",
    "retry_policy",
    "exclusion_policy",
    "confidence_level",
    "max_harness_fraction",
    "max_collector_fraction",
    "precision_relative_halfwidth",
    "max_noise_cv",
    "max_load_1m",
    "max_temperature_c",
    "max_throttle_ratio",
    "cold_start_boundary",
    "sequential_method",
    "precision_checkpoints",
    "require_environment_observations",
    "protocol_id",
    "thread_monitor_interval_ns"
  ],
  "properties": {
    "outer_repetitions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "encode_min_ns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "decode_min_ns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "max_trial_wall_ns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "max_total_wall_ns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "max_inner_iterations": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "min_outer_repetitions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "pilot_repetitions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "min_clock_signal_ratio": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "warmup_min_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "warmup_min_ns": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "max_retries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "pilot_seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "profile": {
      "enum": [
        "STEADY_PROCESS",
        "COLD_PROCESS"
      ]
    },
    "start_method": {
      "enum": [
        "spawn",
        "fork"
      ]
    },
    "worker_initial_state": {
      "enum": [
        "FRESH_INTERPRETER",
        "FORK_SNAPSHOT"
      ]
    },
    "timing_scope": {
      "enum": [
        "CORE",
        "PIPELINE",
        "E2E"
      ]
    },
    "cache_policy": {
      "enum": [
        "WARM_INPUT_OS_CACHE_UNCONTROLLED",
        "OS_CACHE_UNCONTROLLED"
      ]
    },
    "collector_mode": {
      "enum": [
        "ENABLED",
        "DISABLED"
      ]
    },
    "stop_mode": {
      "enum": [
        "FIXED_REPETITIONS",
        "FIXED_BUDGET",
        "PRECISION_PREDECLARED"
      ]
    },
    "schema_version": {
      "const": "tscb.measurement-protocol.v3.2"
    },
    "estimand": {
      "const": "DIRECTION_NS_PER_INDEPENDENT_OBJECT"
    },
    "clock": {
      "const": "PERF_COUNTER_NS"
    },
    "context_policy": {
      "const": "FRESH_ENCODE_AND_DECODE_CONTEXT_PER_OBJECT"
    },
    "retry_policy": {
      "const": "FAILED_ATTEMPTS_ONLY_RETAIN_ALL"
    },
    "exclusion_policy": {
      "const": "PREDECLARED_CORRECTNESS_RESOURCE_AND_ENVIRONMENT_GATES"
    },
    "confidence_level": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "max_harness_fraction": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "max_collector_fraction": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "precision_relative_halfwidth": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "max_noise_cv": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "max_load_1m": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "max_temperature_c": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "max_throttle_ratio": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "cold_start_boundary": {
      "enum": [
        null,
        "SPAWN_THROUGH_OUTPUT_MATERIALIZATION"
      ]
    },
    "sequential_method": {
      "enum": [
        null,
        "BONFERRONI_LOOKS"
      ]
    },
    "precision_checkpoints": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9223372036854775807
      },
      "uniqueItems": true,
      "maxItems": 1000000
    },
    "require_environment_observations": {
      "type": "boolean"
    },
    "protocol_id": {
      "type": "string",
      "minLength": 1
    },
    "thread_monitor_interval_ns": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "description": "Full frozen document. Runtime additionally checks combined wall budgets, decimal ranges, monotonic checkpoints and protocol identity.",
  "allOf": [
    {
      "if": {
        "properties": {
          "start_method": {
            "const": "spawn"
          }
        }
      },
      "then": {
        "properties": {
          "worker_initial_state": {
            "const": "FRESH_INTERPRETER"
          }
        }
      },
      "else": {
        "properties": {
          "worker_initial_state": {
            "const": "FORK_SNAPSHOT"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "profile": {
            "const": "COLD_PROCESS"
          }
        }
      },
      "then": {
        "properties": {
          "start_method": {
            "const": "spawn"
          },
          "warmup_min_count": {
            "const": 0
          },
          "warmup_min_ns": {
            "const": 0
          },
          "cold_start_boundary": {
            "const": "SPAWN_THROUGH_OUTPUT_MATERIALIZATION"
          },
          "cache_policy": {
            "const": "OS_CACHE_UNCONTROLLED"
          }
        }
      },
      "else": {
        "properties": {
          "cold_start_boundary": {
            "type": "null"
          }
        },
        "anyOf": [
          {
            "properties": {
              "warmup_min_count": {
                "minimum": 1
              }
            }
          },
          {
            "properties": {
              "warmup_min_ns": {
                "minimum": 1
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "stop_mode": {
            "const": "PRECISION_PREDECLARED"
          }
        }
      },
      "then": {
        "properties": {
          "min_outer_repetitions": {
            "minimum": 2
          },
          "precision_relative_halfwidth": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
          },
          "sequential_method": {
            "const": "BONFERRONI_LOOKS"
          },
          "precision_checkpoints": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "precision_relative_halfwidth": {
            "type": "null"
          },
          "sequential_method": {
            "type": "null"
          },
          "precision_checkpoints": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
