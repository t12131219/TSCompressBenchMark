{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tscb.resource-lease.v3.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_set_id",
    "owner_pid",
    "acquired_ns",
    "logical_cpus",
    "threads",
    "processes",
    "memory_limit_bytes",
    "numa_nodes",
    "lock_path",
    "lease_id",
    "status",
    "lock_method",
    "exclusion_scope",
    "external_process_occupancy_controlled",
    "hard_process_tree_limit",
    "hard_rss_limit",
    "memory_admission",
    "numa_memory_binding",
    "affinity_scope",
    "thread_budget_verification",
    "lifetime_scope",
    "owner_exit_scope",
    "allow_smt",
    "thread_budget",
    "topology",
    "before",
    "after",
    "boundary",
    "released_ns"
  ],
  "properties": {
    "schema_version": {
      "const": "tscb.resource-lease.v3.2"
    },
    "run_set_id": {
      "type": "string",
      "minLength": 1
    },
    "owner_pid": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "acquired_ns": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "logical_cpus": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9223372036854775807
      }
    },
    "threads": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "processes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "memory_limit_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "numa_nodes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9223372036854775807
      }
    },
    "lock_path": {
      "type": "string",
      "minLength": 1
    },
    "lease_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "HELD",
        "RELEASED"
      ]
    },
    "lock_method": {
      "const": "LINUX_FLOCK_EXCLUSIVE_HOST_COORDINATOR"
    },
    "exclusion_scope": {
      "const": "COOPERATING_PROCESSES_SAME_HOST_ACCOUNT_AND_LOCK_NAMESPACE"
    },
    "external_process_occupancy_controlled": {
      "const": false
    },
    "hard_process_tree_limit": {
      "const": false
    },
    "hard_rss_limit": {
      "const": false
    },
    "memory_admission": {
      "const": "MEMAVAILABLE_BOUNDARY_CHECK_NOT_OS_RESERVATION"
    },
    "numa_memory_binding": {
      "const": "NOT_ENFORCED_CPU_AFFINITY_ONLY"
    },
    "affinity_scope": {
      "const": "CALLING_THREAD_AND_FUTURE_CHILDREN"
    },
    "thread_budget_verification": {
      "const": "CALLER_MUST_CHECK_EACH_WORKER_PROCESS"
    },
    "lifetime_scope": {
      "const": "OWNER_MUST_STOP_WORKERS_BEFORE_RELEASE"
    },
    "owner_exit_scope": {
      "const": "KERNEL_RELEASES_ON_LAST_INHERITED_DESCRIPTOR_CLOSE"
    },
    "allow_smt": {
      "type": "boolean"
    },
    "thread_budget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "topology": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "logical_cpu",
          "package_id",
          "core_id",
          "physical_core_id",
          "core_type",
          "thread_siblings",
          "numa_nodes",
          "reason"
        ],
        "properties": {
          "logical_cpu": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "package_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "core_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "physical_core_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "core_type": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "thread_siblings": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "numa_nodes": {
            "anyOf": [
              {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854775807
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "enum": [
              null,
              "TOPOLOGY_UNAVAILABLE"
            ]
          }
        }
      }
    },
    "before": {
      "$ref": "environment-boundary.schema.json"
    },
    "after": {
      "anyOf": [
        {
          "$ref": "environment-boundary.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "boundary": {
      "$ref": "environment-boundary.schema.json"
    },
    "released_ns": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9223372036854775807
    }
  },
  "if": {
    "properties": {
      "status": {
        "const": "HELD"
      }
    }
  },
  "then": {
    "properties": {
      "after": {
        "type": "null"
      },
      "released_ns": {
        "type": "null"
      }
    }
  },
  "else": {
    "properties": {
      "after": {
        "$ref": "environment-boundary.schema.json"
      },
      "released_ns": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9223372036854775807
      }
    }
  }
}
