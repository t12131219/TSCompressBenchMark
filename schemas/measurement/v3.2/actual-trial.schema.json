{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tscb.actual-trial.v3.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schedule_id",
    "trial_id",
    "pair_id",
    "dataset_id",
    "method_id",
    "execution_job_id",
    "block_index",
    "round_index",
    "repetition_index",
    "sequence_index",
    "attempt_index",
    "attempt_id",
    "event_index",
    "status",
    "started_ns",
    "finished_ns",
    "recorded_ns",
    "observation_ref"
  ],
  "properties": {
    "schema_version": {
      "const": "tscb.actual-trial.v3.2"
    },
    "schedule_id": {
      "type": "string",
      "minLength": 1
    },
    "trial_id": {
      "type": "string",
      "minLength": 1
    },
    "pair_id": {
      "type": "string",
      "minLength": 1
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "method_id": {
      "type": "string",
      "minLength": 1
    },
    "execution_job_id": {
      "type": "string",
      "minLength": 1
    },
    "block_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "round_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "repetition_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "sequence_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "attempt_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "event_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "status": {
      "enum": [
        "PASS",
        "UNSUPPORTED",
        "ADAPTER_LOSSY_ROUTED",
        "ISA_UNSUPPORTED",
        "BUILD_UNAVAILABLE",
        "SOURCE_INCOMPLETE",
        "LICENSE_RESTRICTED",
        "HARNESS_CAPACITY_ERROR",
        "MEMORY_SAFETY_FAIL",
        "RESOURCE_PRESSURE",
        "OVERSUBSCRIBED",
        "CORRECTNESS_FAIL",
        "BOUND_VIOLATION",
        "OOM",
        "TIMEOUT",
        "INCOMPARABLE",
        "NONDETERMINISTIC",
        "CRASHED",
        "SCHEMA_ERROR",
        "INCONCLUSIVE"
      ]
    },
    "started_ns": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "finished_ns": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "recorded_ns": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "observation_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "description": "Runtime validates sequential attempts/events, planned membership, terminal success and frozen retry budget."
}
