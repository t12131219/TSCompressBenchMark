  "cards": [
    {"dot": "cyan", "title": "Layer 1-2 的冻结内容", "items": ["数据集 manifest、canonical artifact、characterization、codec/source/alias snapshot、resolved configs 和 task_plan 都保存在 run set", "每个任务带有兼容性、预处理计划、执行解析、资源限制和嵌套比较键"]},
    {"dot": "emerald", "title": "预检与正式重复", "items": ["不兼容、输入/边界失败和预热失败形成 diagnostic RunRecord；每个失败带 reason_code", "正式重复在隔离进程中执行压缩、Finalize、解码、正确性、账本、计时和资源观测；query/streaming 可作为额外工作负载"]},
    {"dot": "amber", "title": "Layer 5 的聚合规则", "items": ["报告只读任务计划和追加式原始证据，不重跑 codec", "只在相同语义、执行、资源比较键内聚合 PASS FORMAL_REPETITION；coverage 保留全部计划任务"]}
