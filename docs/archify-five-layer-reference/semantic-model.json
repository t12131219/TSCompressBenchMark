{
  "title": "TSDataCompressBenchMark · 五层运行框架与数据流",
  "phases": [
    {
      "id": "data",
      "title": "数据准备",
      "en": "Data Preparation",
      "duties": [
        "统一原对象与输入",
        "保留语义与派生链",
        "冻结可复用数据基础"
      ],
      "outputs": [
        "DatasetID / Manifest / Canonical",
        "LogicalObjectSchema / P2 输入",
        "完整 T / V / mask 与 typed schema",
        "特征 / 准备记录 / 原始 RawBits"
      ],
      "constraints": [
        "校验源字节与内容身份",
        "不隐式排序 / cast / 填充",
        "显式派生、轴、单位和来源链",
        "async/ragged 不扩大 codec 原生域",
        "P2 不强制沿用 legacy wire"
      ]
    },
    {
      "id": "plan",
      "title": "能力与配置",
      "en": "Capability & Configuration",
      "duties": [
        "Legacy 能力与任务",
        "V3.2 事前合同编译",
        "冻结全矩阵与真实调度"
      ],
      "outputs": [
        "Legacy task_plan / 配置 / 三级键",
        "experiment_decision / bundle",
        "Expected Matrix / 公共投影",
        "ExecutionJob / Recipe / Schedule",
        "Closure / Build / Environment"
      ],
      "constraints": [
        "完整合法配置与期待分母",
        "别名/参数/ISA 不增加方法数",
        "CORE 两方法、两真实来源",
        "API 实际 schema / bytes 相同",
        "旧比较键不授新组资格"
      ]
    },
    {
      "id": "exec",
      "title": "执行验证",
      "en": "Execution & Validation",
      "duties": [
        "输入安全与正确性",
        "独立恢复与开发 pilot",
        "分 lane 正式对象执行"
      ],
      "outputs": [
        "Preflight / 资格与恢复证据",
        "独立 development pilot",
        "P1/P2 完整产物与 FinalBits",
        "comparison / workload / P2",
        "失败原因与原域 correctness"
      ],
      "constraints": [
        "资格与 pilot 是测量门禁",
        "Finalize 与恢复依赖计入成本",
        "最后内循环对象供公共验证",
        "Rate/Summary 无活动正式组",
        "流程存在不等于当前运行通过"
      ]
    },
    {
      "id": "measure",
      "title": "性能测评",
      "en": "Performance Evaluation",
      "duties": [
        "同次计时与资源",
        "独立 profile 与工作负载",
        "持久证据与中断审计"
      ],
      "outputs": [
        "CORE / PIPELINE / cold 边界",
        "ResourceLease / 线程观测",
        "Legacy raw / CSV 投影",
        "comparison / workload / P2 trials",
        "STARTED / Events / 恢复产物"
      ],
      "constraints": [
        "同次采集，非第二轮测量",
        "Query / stream 各自冻结协议",
        "未知 STARTED 不自动重测",
        "P2 持久预留预算与事件链",
        "collector/counters 如实 availability"
      ]
    },
    {
      "id": "stats",
      "title": "统计分析与报告",
      "en": "Statistics & Reporting",
      "duties": [
        "按合同核验资格",
        "真实配对与固定分母",
        "报告、辅助审计与验收"
      ],
      "outputs": [
        "Legacy CSV / median / 三级键",
        "V3.2 block 配对 / 固定矩阵",
        "质量 / Pareto / Coverage / 缺口",
        "分析 JSON / HTML / P2 报告",
        "参考成本 / completion / 条款验收"
      ],
      "constraints": [
        "Legacy 重复要求按其合同",
        "V3.2 精度与配对块按冻结政策",
        "缺口 / INCONCLUSIVE 保留",
        "仅冻结 corpus / 本机范围",
        "辅助审计不替代 FORMAL/parity"
      ]
    }
  ],
