{
  "title": "TSDataCompressBenchMark · 五层运行框架与数据流",
  "phases": [
    {
      "id": "data",
      "title": "数据准备",
      "en": "Data Preparation",
      "duties": [
        "统一数据输入",
        "保留原始语义",
        "冻结可复用数据基础"
      ],
      "outputs": [
        "DatasetID / Manifest 快照",
        "*.canonical.tscb",
        "*.characterization.json",
        "preparation-record.json",
        "冻结配置 / environment.json"
      ],
      "constraints": [
        "校验源文件 SHA-256",
        "不隐式排序或重采样",
        "保留 shape / dtype / validity",
        "保留 timestamp 来源与 topology",
        "复用工件须验证一致性"
      ]
    },
    {
      "id": "plan",
      "title": "能力与配置",
      "en": "Capability & Configuration",
      "duties": [
        "注册算法与来源",
        "展开完整参数空间",
        "生成任务与可比性键"
      ],
      "outputs": [
        "AlgorithmID / SourceArtifactID",
        "ConfigID / resolved_configs.json",
        "显式适配与预处理计划",
        "ExecutionPathHash / 三级键",
        "task_plan.jsonl / 注册快照"
      ],
      "constraints": [
        "按数据与参数匹配能力",
        "此阶段制定计划，不执行适配",
        "实际 ISA / fallback 可追溯",
        "冻结完整任务全集",
        "不静默丢弃不支持组合"
      ]
    },
    {
      "id": "exec",
      "title": "执行验证",
      "en": "Execution & Validation",
      "duties": [
        "Track 安全路由",
        "预检与隔离执行",
        "逐次验证完整编解码"
      ],
      "outputs": [
        "Preflight / Warmup 记录",
        "逐次 Correctness 与原因",
        "FinalBits / 完整成本",
        "bitstream / input 与输出哈希",
        "PASS 与各类失败诊断"
      ],
      "constraints": [
        "输入 / canary / 边界检查",
        "超时与内存限制、进程隔离",
        "Finalize 必须计入完整对象",
        "每次正式 repetition 仍验证",
        "不同 LossMode 按契约检查"
      ]
    },
    {
      "id": "measure",
      "title": "性能测评",
      "en": "Performance Evaluation",
      "duties": [
        "与正式实验共享执行",
        "分口径计时与资源采集",
        "条件查询与流式工作负载"
      ],
      "outputs": [
        "Encode / Decode / E2E 计时",
        "CORE / PIPELINE 分离",
        "同次 CPU / Memory / I/O",
        "条件 Query / Streaming 结果",
        "RunID / 原始记录 / CSV 投影"
      ],
      "constraints": [
        "编码、解码分别满足最短时长",
        "E2E 模式还须 E2E 达标",
        "Query / Streaming 请求且支持",
        "Energy / counters 未激活时",
        "记录 NOT_COLLECTED / UNSUPPORTED"
      ]
    },
    {
      "id": "stats",
      "title": "统计分析与报告",
      "en": "Statistics & Reporting",
      "duties": [
        "证据资格过滤",
        "分层比较与完整覆盖率",
        "统计、排名与最终报告"
      ],
      "outputs": [
        "eligibility.csv / summary.csv",
        "corpus_summary.csv",
        "comparability.csv / pareto.csv",
        "ranking.csv / coverage.csv",
        "机器报告 / Markdown / HTML"
      ],
      "constraints": [
        "只读冻结证据，不再调用 codec",
        "资格过滤先于统计聚合",
        "性能计划完整且至少 10 次",
        "仅在相应可比性组内比较",
        "Coverage 不是综合评分"
      ]
    }
  ],
