 #include "bitpacking.h"
 
+/* TSCB build-only correction: preserve original packing grammar/kernel calls;
+ * fix zero-width output size and use memcpy for word accesses, including odd
+ * bit-width offsets. Original vendor bytes are retained separately. */
+static inline uint32_t tscb_load32(const uint8_t *p) {
+    uint32_t value;
+    memcpy(&value, p, sizeof(value));
+    return value;
+}
+static inline void tscb_store32(uint8_t *p, uint32_t value) {
+    memcpy(p, &value, sizeof(value));
+}
+
