diff --git a/src/utils/zig_zag_codec.h b/src/utils/zig_zag_codec.h
index a31bc57..9645a9f 100644
--- a/src/utils/zig_zag_codec.h
+++ b/src/utils/zig_zag_codec.h
@@ -5,10 +5,12 @@
 class ZigZagCodec {
  public:
   static inline int64_t Encode(int64_t value) {
-    return (value << 1) ^ (value >> 63);
+    const uint64_t bits = static_cast<uint64_t>(value);
+    return static_cast<int64_t>((bits << 1) ^ static_cast<uint64_t>(value >> 63));
   }
 
   static inline int64_t Decode(int64_t value) {
-    return (value >> 1) ^ -(value & 1);
+    const uint64_t bits = static_cast<uint64_t>(value);
+    return static_cast<int64_t>((bits >> 1) ^ (0ULL - (bits & 1ULL)));
   }
 };
diff --git a/src/utils/output_bit_stream.cc b/src/utils/output_bit_stream.cc
index 0481111..a76de20 100644
--- a/src/utils/output_bit_stream.cc
