@@ -9,6 +9,7 @@ OutputBitStream::OutputBitStream(uint32_t buffer_size) {
 }
 
 uint32_t OutputBitStream::Write(uint64_t content, uint32_t len) {
+  if (len == 0) return 0;
   content <<= (64 - len);
   buffer_ |= (content >> bit_in_buffer_);
   bit_in_buffer_ += len;
