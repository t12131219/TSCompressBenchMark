diff --git a/src/utils/serf_utils_32.cc b/src/utils/serf_utils_32.cc
index 05703e4..6f56a0a 100644
--- a/src/utils/serf_utils_32.cc
+++ b/src/utils/serf_utils_32.cc
@@ -25,9 +25,11 @@ SerfUtils32::FindAppInt(float min_float, float max_float, uint32_t sign, float original, uint32_t last_int,
   // may be negative zero
   uint32_t min = Float::FloatToIntBits(min_float) & 0x7fffffff;
   uint32_t max = Float::FloatToIntBits(max_float);
-  int leading_zeros = __builtin_clz(min ^ max);
-  int32_t front_mask = 0xffffffff << (32 - leading_zeros);
-  int shift = 32 - leading_zeros;
+  uint32_t differing = min ^ max;
+  int leading_zeros = differing ? __builtin_clz(differing) : 32;
+  uint32_t front_mask = leading_zeros == 32 ? UINT32_MAX :
+      (leading_zeros == 0 ? 0U : UINT32_MAX << (32 - leading_zeros));
+  int shift = 32 - leading_zeros > 31 ? 31 : 32 - leading_zeros;
   uint32_t result_int;
   float diff;
   uint32_t append;
