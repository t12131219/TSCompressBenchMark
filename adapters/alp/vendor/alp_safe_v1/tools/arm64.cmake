set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
if(NOT DEFINED ENV{ALP_ARM_TOOLCHAIN})
  message(FATAL_ERROR "Set ALP_ARM_TOOLCHAIN before configure/build/test")
endif()
set(CMAKE_SYSROOT "$ENV{ALP_ARM_TOOLCHAIN}")
set(CMAKE_C_COMPILER "${CMAKE_CURRENT_LIST_DIR}/arm64-cc")
set(CMAKE_CXX_COMPILER "${CMAKE_CURRENT_LIST_DIR}/arm64-cxx")
set(CMAKE_CROSSCOMPILING_EMULATOR "${CMAKE_CURRENT_LIST_DIR}/arm64-run")
