 {
-    return *reinterpret_cast<const uint32_t*>( inputCursor ) * 0x1e35a7bd >> ( 32 - FAST_HASH_BITS );
+    return LoadUnaligned<uint32_t>( inputCursor ) * 0x1e35a7bd >> ( 32 - FAST_HASH_BITS );
 }
 
