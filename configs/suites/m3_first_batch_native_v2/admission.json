{
  "schema":"bmk.native-admission-policy/1",
  "environment":{"os":"linux","arch":"x86_64","device":"cpu","libc":"glibc","python_environment_lock":"environment/tsbench-linux-64.lock.json","build_profile":"Release","c_cxx_compiler":"GNU 11.4.0","cmake":"3.22.1","isolation":"files_only_bubblewrap_compatible_cpu"},
  "protocols":{
    "batch":{"completion":"complete_output_or_original_domain_restore","retain":["encoded_product","ordered_schema_and_shape"]},
    "batch_parallel":{"completion":"join_all_native_jobs_and_publish_complete_product","retain":["encoded_product","ordered_schema_and_shape","actual_native_thread_and_work_observation"]},
    "complete_pages_incremental_decode":{"completion":"bounded_drain_of_complete_page_with_chunk_metadata","retain":["page_payload","file_and_chunk_metadata","cumulative_output_quota_and_drain_observations"]},
    "native_query":{"completion":"return_exact_per_channel_count_sum_max_without_dense_output","retain":["encoded_product","ordered_shape_and_dtype","original_domain_aggregate_oracle","backend_and_materialization_observation"]},
    "native_packet_stream":{"completion":"pre_finish_packet_commit_with_retry_and_explicit_finish","retain":["standalone_tsc1","packet_boundaries","accepted_pending_padded_value_ledger"]},
    "indexed_read_at":{"completion":"return_requested_original_point_bits_or_range","retain":["indexed_backing_file","reader_options","open_and_request_logical_reads"]},
    "stateless_range_validates_container":{"completion":"return_requested_range_after_full_container_validation","retain":["complete_container","requested_range_and_output_capacity","whole_validation_work"]},
    "snapshot_replay":{"completion":"restore_snapshot_then_append_and_finalize","retain":["snapshot","resumed_and_uninterrupted_products","source_scan_and_copy_observations"]},
    "sequential_iterator":{"completion":"return_original_samples_from_forward_scan","retain":["native_chunk","seek_requests_and_positions","logical_scan_work"]},
    "mutable_array":{"completion":"flush_reopen_and_verify_persisted_updates_and_untouched_values","retain":["before_and_after_arrays","array_metadata","requested_writes_and_post_persist_oracle"]},
    "native_span_stream":{"completion":"drain_and_finish_all_caller_spans_not_just_first_output","retain":["complete_native_stream","feed_output_capacity_finish_and_reset_observations"]},
    "dictionary_batch":{"completion":"restore_with_exact_declared_external_asset","retain":["complete_encoded_product","dictionary_or_decode_table_bytes_and_identity","missing_and_wrong_asset_rejections"]},
    "finish_finalized_incremental":{"completion":"restore_finished_stream_after_incremental_ingest","retain":["finished_product","ingest_and_finish_observations"]},
    "progressive_prefix":{"completion":"decode_each_declared_prefix_without_later_layers","retain":["each_declared_prefix","effective_epsilon_and_level_sizes"]},
    "multipass_replay":{"completion":"finish_all_replay_passes_and_restore_prefixes","retain":["each_declared_prefix","source_pass_and_sink_work_ledger","effective_epsilon_and_level_sizes"]},
    "model_batch":{"completion":"restore_all_ordered_columns_from_self_contained_crd1","retain":["model_bound_encoded_product","ordered_schema","calibration_identity_and_heldout_quality_decisions"]},
    "model_training":{"completion":"publish_valid_model_and_exercise_detached_heldout_restore","retain":["model_bytes_and_provenance","training_input_identity_and_options","solver_or_bridge_diagnostics","heldout_product_and_error_observations"]}
  },
  "routes":[
    {"selection":9,"route":"auto-batch","domain":"冻结的 f32/f64 密集值；Decimal/RD/raw 分开覆盖，保留可接受特殊位型"},
    {"selection":9,"route":"decode-backends","domain":"冻结 f32/f64 帧；显式 SIMD 是 f64 decimal 条件路线，RD/raw 不是 decimal 工作"},
    {"selection":11,"route":"source-auto","domain":"冻结 Source Auto 数值类型与页块，含 f16 特殊位；不接受未登记的 dtype"},
    {"selection":11,"route":"c-native-auto","domain":"冻结 CNativeAuto 数值类型与编码，按原绑定拒绝 f16；独立于 Source Auto 格式"},
    {"selection":11,"route":"source-pages","domain":"完整 source page 与匹配 chunk metadata；非在线单遍编码"},
    {"selection":11,"route":"native-pages","domain":"完整 native page 与匹配 chunk metadata；独立 ownership 和累计解码配额"},
    {"selection":11,"route":"intmult","domain":"显式无符号整数与整数 base；经典编码回退单记，浮点与非法 base 拒绝"},
    {"selection":19,"route":"fire-batch","domain":"冻结原生 FIRE u8/u16 交错通道、lowdim/generic 和尾形；SFB1 与 typed ABI 外层分别核对"},
    {"selection":19,"route":"query","domain":"冻结 FIRE 无符号逐通道 count/sum/max；不扩展为解码后任意查询"},
    {"selection":85,"route":"batch","domain":"冻结 u8/u16/u32/u64 和分块、容量边界；TCHY 恢复"},
    {"selection":85,"route":"packet-stream","domain":"冻结 packet 入口与 TSC1 完整封装；背压/重试/尾 padding 与 finish"},
    {"selection":85,"route":"loaded-file-access","domain":"冻结已有文件 reader 的 point/bit/range；逻辑 read_at 字节不是物理 I/O"},
    {"selection":85,"route":"batch-range","domain":"冻结批输入全容器验证后的原始 range；不等同索引访问"},
    {"selection":7,"route":"tv-batch","domain":"同轴 i64 毫秒 T + binary64 V，独立 0–512 行块；无假时间列"},
    {"selection":7,"route":"append-resume","domain":"同轴 i64 毫秒 T + binary64 V；合法 snapshot 与 append/resume，扫描与拷贝计费"},
    {"selection":7,"route":"iterator","domain":"合法原生块顺序迭代及 forward seek；不作为索引随机访问"},
    {"selection":31,"route":"field-baseline","domain":"冻结 reversible i32/i64/f32/f64 dense fields，块边界及尾部；拒绝空 field"},
    {"selection":31,"route":"field-modes","domain":"预声明 f32/f64 有损 field 和 i64 reversible；rank 1–4 与指定 stride，不把 rate/precision 当误差界"},
    {"selection":31,"route":"openmp-encode","domain":"同一 reversible field 的 serial/OMP1/OMP2；decode 仍为调用线程"},
    {"selection":31,"route":"fixed-rate-array","domain":"冻结 f64 fixed-rate array 写入/逐出/持久化；非普通 field 格式"},
    {"selection":40,"route":"zstd-baseline","domain":"冻结字节对象/短块/legacy 64 KiB 边界；level 3 独立完整帧"},
    {"selection":40,"route":"zstd-session","domain":"冻结 caller-span 会话输入/输出容量、drain、finish、错误后 reset"},
    {"selection":40,"route":"zstd-dictionary","domain":"训练分区生成字典、留出样本恢复；缺失或错字典拒绝"},
    {"selection":40,"route":"zstd-workers","domain":"冻结同输入同选项的 0/2 编码后台 worker 对照；不声称解码并行"},
    {"selection":39,"route":"xz-baseline","domain":"冻结 XZ/LZMA2 字节完整帧、小块及 legacy 64 KiB 边界"},
    {"selection":39,"route":"xz-session","domain":"冻结 caller-span XZ 进度与 finish/reset；按解码资源护栏拒绝"},
    {"selection":39,"route":"xz-workers","domain":"冻结同步/后台 1/2 worker；解码比较固定同一多块码流"},
    {"selection":4,"route":"selfstar-batch","domain":"冻结有序 f32/f64 SElf* V1；保留 native reset、块与原生上限边界"},
    {"selection":4,"route":"selfstar-incremental","domain":"冻结 update/flush/finish；update 可用不等于 finish 前可恢复输出"},
    {"selection":29,"route":"huff0-reference","domain":"冻结 FEC1 字节帧和原生后端分派；相同 payload 做 BMI2/portable 解码对照"},
    {"selection":29,"route":"huff0-shared-table","domain":"固定 ETB1 字节块与序列化模型；U16 表示若使用仅比较其明确转换对象"},
    {"selection":87,"route":"pbepla-progressive","domain":"冻结有限 f64 原值与有序 eps 梯、原生几何和边界；每前缀单独恢复"},
    {"selection":87,"route":"pbepla-replay","domain":"冻结非空三遍/空一遍及读重置、sink、限额反例；不作为在线单遍"},
    {"selection":80,"route":"corad-inference","domain":"相同留出窗口的有序有限 f64 多列；两个已冻结 CRD1 部署分别判定，不用于重新校准"},
    {"selection":80,"route":"corad-c-training","domain":"冻结 train 窗口、C LARS 配置和 solver oracle；模型合法不等同 held-out 质量通过"},
    {"selection":80,"route":"corad-source-training","domain":"冻结 train 窗口、source sklearn bridge 和进程/线程依赖；不声称模型位级复现"}
  ]
}
